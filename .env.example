# PostHog analytics (https://app.posthog.com → Project Settings → Project API Key)
# Leave unset locally if you don't want events while developing.
PUBLIC_POSTHOG_KEY="phc_your_project_api_key_here"
# US cloud default. EU projects use https://eu.i.posthog.com
PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
